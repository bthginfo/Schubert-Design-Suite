{
  "name": "schubert-design-suite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @schubert/web build && node scripts/build-worker.mjs",
    "check": "pnpm --filter @schubert/web check && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "tsx scripts/integration-test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "worker": "tsx apps/worker/src/index.ts",
    "requirements": "tsx scripts/requirements.ts",
    "security:check": "node scripts/security-check.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@fontsource/inter": "5.3.0",
    "@lucide/svelte": "1.58.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@schubert/adapters": "workspace:*",
    "@schubert/ai": "workspace:*",
    "@schubert/application": "workspace:*",
    "@schubert/contracts": "workspace:*",
    "@schubert/db": "workspace:*",
    "@schubert/documents": "workspace:*",
    "@schubert/domain": "workspace:*",
    "@schubert/geometry": "workspace:*",
    "@threlte/core": "8.6.1",
    "@vercel/blob": "2.8.2",
    "@vercel/functions": "3.10.1",
    "@vercel/oidc": "4.0.1",
    "@vercel/queue": "0.8.0",
    "archiver": "8.0.0",
    "better-auth": "1.7.10",
    "csv-parse": "7.0.3",
    "decimal.js": "10.6.0",
    "dotenv": "18.0.8",
    "drizzle-orm": "0.45.4",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "file-type": "22.2.0",
    "iconv-lite": "0.7.3",
    "idb": "8.0.4",
    "ipaddr.js": "2.5.0",
    "nodemailer": "10.1.2",
    "openai": "7.34.0",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "read-excel-file": "9.3.12",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/archiver": "8.0.0",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
